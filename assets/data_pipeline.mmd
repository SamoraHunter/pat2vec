flowchart TD
    A[Initialize pat2vec main class] --> B{Config Setup}
    B --> C[Load Patient List]
    B --> D[Initialize MedCat NLP]
    B --> E[Setup GPU Environment]

    C --> F[Filter Existing Patient Files]
    F --> G[Start Patient Processing Loop]

    G --> H{Individual Patient Window?}
    H -->|Yes| I[Calculate Patient-Specific Date Range]
    H -->|No| J[Use Global Date Range]

    I --> K[Generate Date List for Patient]
    J --> K

    K --> L{Patient Already Processed?}
    L -->|Yes| M[Skip Patient]
    L -->|No| N[Create Patient Folders]

    N --> O[Data Batch Retrieval Phase]

    O --> P[Get EPR Documents]
    O --> Q[Get MCT Documents]
    O --> R[Get Textual Observations]
    O --> S[Get Reports]
    O --> T[Get Epic Clinical Data]
    O --> ATR[Get Ascribe Translog]

    T --> U[Epic Clinical Notes]
    T --> V[Epic Medical History]
    T --> W[Epic Imaging Reports]
    T --> X[Epic Orders]
    T --> Y[Epic Lab Results]
    T --> Z[Epic Patients]
    T --> AA[Smoking Status]
    T --> AB[Core SpO2]
    T --> AC[Bed Number]
    T --> AD[VTE Status]
    T --> AE[Hospital Site]
    T --> AF[RESUS Status]
    T --> AG[NEWS Scores]
    T --> AH[BMI Data]
    T --> AI[Diagnostics]
    T --> AJ[Drugs/Medications]
    T --> AK[Demographics]
    T --> AL[Blood Results]
    T --> AM[Appointments]
    T --> AN[Ascribe Translog]

    P --> AO[NLP Annotation Phase]
    Q --> AO
    R --> AO
    S --> AO
    U --> AO
    V --> AO
    W --> AO

    AO --> AP[Annotate EPR Documents]
    AO --> AQ[Annotate MCT Documents]
    AO --> AR[Annotate Textual Observations]
    AO --> AS[Annotate Reports]
    AO --> AT[Annotate Epic Clinical Notes]
    AO --> AU[Annotate Epic Medical History]
    AO --> AV[Annotate Epic Imaging Reports]
    AO --> AW[Annotate Epic Orders]

    U --> AX[Epic Data Cleaning Phase]
    V --> AX
    W --> AX
    X --> AX
    Y --> AX
    Z --> AX
    AA --> AX
    AB --> AX
    AC --> AX
    AD --> AX
    AE --> AX
    AF --> AX
    AG --> AX
    AH --> AX
    AI --> AX
    AJ --> AX
    AK --> AX
    AL --> AX
    AM --> AX
    AN --> AX
    ATR --> AX

    AP --> AY[Data Cleaning Phase]
    AQ --> AY
    AR --> AY
    AS --> AY
    AT --> AY
    AU --> AY
    AV --> AY
    AW --> AY
    AX --> AY

    AY --> AZ{Drop NA Timestamps?}
    AZ -->|Yes| BA[Clean Timestamp Data]
    AZ -->|No| BB[Keep All Data]

    BA --> BC[Time Window Processing Loop]
    BB --> BC

    BC --> BD{Calculate Vectors?}
    BD -->|Yes| BE[Call main_batch for Each Date]
    BD -->|No| BF[Skip Vector Calculation]

    BE --> BG[Feature Engineering]
    BG --> BH[Generate Patient Vectors]
    BH --> BI[Save Results]

    BF --> BJ[Continue to Next Patient]
    BI --> BJ
    M --> BJ

    BJ --> BK{More Patients?}
    BK -->|Yes| G
    BK -->|No| BL[Pipeline Complete]

    style A fill:#e1f5fe
    style BL fill:#c8e6c9
    style AO fill:#fff3e0
    style AY fill:#f3e5f5
    style BG fill:#e8f5e8
