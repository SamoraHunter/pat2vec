graph TB
    subgraph "Configuration Layer"
        A[config_pat2vec] --> B[Main Configuration Object]
        B --> C[Feature Engineering Args]
        B --> D[Time Window Settings]
        B --> E[Data Source Options]
    end

    subgraph "Data Sources"
        ES[Cogstack ElasticSearch] --> EPR[EPR Documents]
        ES --> MCT[MCT Documents]
        ES --> OBS[Clinical Observations]
        ES --> BL[Blood Results]
        ES --> DRUGS[Medications/Drugs]
        ES --> DEMO[Demographics]
        ES --> APPS[Appointments]
        ES --> EPI_CLINICAL[Epic Clinical Notes]
        ES --> EPI_MEDHIST[Epic Medical History]
        ES --> EPI_IMAGING[Epic Imaging Reports]
        ES --> EPI_ORDERS[Epic Orders]
        ES --> EPI_LAB[Epic Lab Results]
        ES --> ASCRIBE[Ascribe Translog]
    end

    subgraph "NLP Processing"
        NLP[MedCat NLP Engine] --> CUI[CUI Extraction]
        NLP --> ENT[Entity Recognition]
        NLP --> NEG[Negation Detection]
        EPR --> NLP
        MCT --> NLP
        OBS --> NLP
    end

    subgraph "Core Processing Engine"
        MAIN[main class] --> MAKER[pat_maker function]
            MAKER --> RETRIEVE[Batch Retrieval Methods]
            MAKER --> ANNOTATE[Annotation Methods]
            MAKER --> BATCH[main_batch function]

        RETRIEVE --> EPR_GET[get_pat_batch_epr_docs]
        RETRIEVE --> MCT_GET[get_pat_batch_mct_docs]
        RETRIEVE --> OBS_GET[get_pat_batch_obs]
        RETRIEVE --> DRUGS_GET[get_pat_batch_drugs]
        RETRIEVE --> BL_GET[get_pat_batch_bloods]
        RETRIEVE --> DEMO_GET[get_pat_batch_demo]
        RETRIEVE --> ASCRIBE_GET[get_pat_batch_ascribe_translog]

        ANNOTATE --> EPR_ANNOT[get_pat_batch_epr_docs_annotations]
            ANNOTATE --> MCT_ANNOT[get_pat_batch_mct_docs_annotations]
            ANNOTATE --> OBS_ANNOT[get_pat_batch_textual_obs_annotations]
            ANNOTATE --> EPI_CLIN_ANNOT[get_pat_batch_epic_clinical_notes_annotations]
            ANNOTATE --> EPI_MEDHIST_ANNOT[get_pat_batch_epic_medical_history_annotations]
            ANNOTATE --> EPI_IMAGING_ANNOT[get_pat_batch_epic_imaging_reports_annotations]
            ANNOTATE --> EPI_ORDERS_ANNOT[get_pat_batch_epic_orders_annotations]
        end

    subgraph "Feature Engineering"
        BATCH --> DRUG_FEATS[Drug Features]
        BATCH --> CLIN_FEATS[Clinical Features]
        BATCH --> TEMP_FEATS[Temporal Features]
        BATCH --> NLP_FEATS[NLP Features]

        DRUG_FEATS --> DRUG_COUNT[Drug Count]
        DRUG_FEATS --> DAYS_SINCE[Days Since Last Drug]
        DRUG_FEATS --> DAYS_BETWEEN[Days Between First/Last]

        CLIN_FEATS --> VITALS[Vital Signs]
        CLIN_FEATS --> LAB_RESULTS[Lab Results]
        CLIN_FEATS --> DEMOGRAPHICS[Demographics]
        CLIN_FEATS --> EPI_LAB_FEAT[Epic Lab Results]

        TEMP_FEATS --> WINDOW[Time Windows]
        TEMP_FEATS --> DATERANGES[Date Ranges]

        NLP_FEATS --> CUI_VECTORS[CUI Vectors]
        NLP_FEATS --> ENT_COUNTS[Entity Counts]
        NLP_FEATS --> NEG_FLAGS[Negation Flags]
    end

    subgraph "Output Layer"
        OUTPUT[Patient Vectors] --> CSV[CSV Files]
        OUTPUT --> ANNOT_OUT[Annotation Files]
        OUTPUT --> FEAT_MATRIX[Feature Matrices]
    end

    A --> MAIN
    ES --> RETRIEVE
    NLP --> ANNOTATE
    CUI --> NLP_FEATS
    ENT --> NLP_FEATS
    NEG --> NLP_FEATS

    DRUG_FEATS --> OUTPUT
    CLIN_FEATS --> OUTPUT
    TEMP_FEATS --> OUTPUT
    NLP_FEATS --> OUTPUT

    style A fill:#e3f2fd
    style NLP fill:#fff3e0
    style MAIN fill:#f3e5f5
    style BATCH fill:#e8f5e8
    style OUTPUT fill:#c8e6c9
